# ---- copy to .env and fill in. Never commit the real .env ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=portal.example.ir,localhost,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.ir,http://localhost:8080
CORS_ALLOWED_ORIGINS=https://portal.example.ir
FRONTEND_URL=https://portal.example.ir
SECURE_COOKIES=1

POSTGRES_DB=man
POSTGRES_USER=man
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=pgbouncer
POSTGRES_PORT=6432
DB_BEHIND_PGBOUNCER=1
DB_CONN_MAX_AGE=0

REDIS_URL=redis://redis-cache:6379/0
CELERY_BROKER_URL=redis://redis-broker:6379/0
CELERY_RESULT_BACKEND=redis://redis-broker:6379/1

GUNICORN_WORKERS=5
GUNICORN_THREADS=4
CELERY_CONCURRENCY=4

# SMS: console | kavenegar
SMS_BACKEND=console
SMS_API_KEY=
SMS_SENDER=
# 1 only for demo/staging: the API returns the OTP code
OTP_DEBUG_ECHO=0

# Payment: mock | zarinpal
PAYMENT_GATEWAY=mock
PAYMENT_MERCHANT_ID=

# Accounting bridge: mock | rest
ACCOUNTING_BACKEND=mock
ACCOUNTING_API_URL=
ACCOUNTING_API_TOKEN=

THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_OTP=5/min
